{
  "name": "akira/setup",
  "description": "Interactive Laravel project setup command with best practices, testing tools, and CI/CD workflows",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "setup",
    "scaffolding",
    "dev-tools",
    "ci-cd",
    "testing"
  ],
  "authors": [
    {
      "name": "Kidiatoliny",
      "email": "kidiatoliny@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/console": "^12.0",
    "illuminate/support": "^12.0",
    "symfony/process": "^7.0"
  },
  "require-dev": {
    "akira/laravel-debugger": "v1.3.1",
    "driftingly/rector-laravel": "^2.1",
    "larastan/larastan": "^3.8",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.5",
    "orchestra/testbench": "^10.0",
    "peckphp/peck": "^0.2",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "pestphp/pest-plugin-type-coverage": "^4.0.3",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Akira\\Setup\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Akira\\Setup\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "pint",
    "refactor": "rector",
    "test:lint": "pint --test",
    "test:refactor": "rector --dry-run",
    "test:types": "phpstan",
    "test:type-coverage": "pest --type-coverage --min=100 --compact",
    "test:coverage": "pest --parallel --coverage --compact --exactly=85.7",
    "test:typos": "peck",
    "test": [
      "@test:lint",
      "@test:refactor",
      "@test:typos",
      "@test:types",
      "@test:coverage",
      "@test:type-coverage"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Akira\\Setup\\AkiraSetupServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
